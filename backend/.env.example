# Copy to .env and adjust. .env is gitignored.

# --- Database ---
# Local MongoDB. To move to Atlas later, only this line changes.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=projectmind

# --- Embedding model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Hybrid retrieval weights (must sum to 1.0) ---
# Measured optimum at 500 projects (see config.py for the full sweep table).
# These match the config.py defaults; change both together or leave both alone.
DENSE_WEIGHT=0.80
SPARSE_WEIGHT=0.20

DEFAULT_TOP_K=10
MAX_TOP_K=50
DUPLICATE_THRESHOLD=0.92

# --- Personalisation ---
# Fraction of the final score taken from the caller's own taste profile:
# fused = (1 - w) * relevance + w * affinity. Set to 0 to disable entirely.
PERSONALIZATION_WEIGHT=0.15
PERSONALIZATION_QUERY_WEIGHT=0.4
PERSONALIZATION_MAX_QUERIES=5

# --- API ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Defaults to 0 (safe) so a plain `copy .env.example .env` never turns the
# debugger on by accident — it can execute arbitrary code from the browser
# on an unhandled exception. Set to 1 in your own .env for local development
# (auto-reload + the interactive debugger); leave at 0 anywhere this might
# be deployed.
FLASK_DEBUG=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_HISTORY_PER_DEVICE=50

# --- AI assistant (chat) ---
# Get a free key at https://console.groq.com/keys. Leave blank to disable the
# chat assistant endpoint — every other feature in this app works without it.
GROQ_API_KEY=
# Optional: extra keys to round-robin/fall back across when one is
# rate-limited, comma-separated (e.g. from separate Groq accounts/projects
# you legitimately hold). Leave blank to use only GROQ_API_KEY above.
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Email notifications (optional) ---
# Notifications always work in-app regardless of this section (see notify.py).
# Fill these in to also email them — e.g. a Gmail address with an App
# Password (not your normal password): https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
